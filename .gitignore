# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
__pycache__/
*.py[cod]
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# GOAR OS local configuration and durable runtime data
.env
.env.local
workspace/*
!workspace/.gitkeep
goar-state/

# GOAR Alpine PRoot generated runtime
proot/rootfs/
proot/.cache/
proot/state/
proot/workspace/*
!proot/workspace/.gitkeep
proot/goar.env
proot/goar-alpine-*.tar.gz

# Android local build products and SDK configuration
android/.gradle/
android/local.properties
android/release-signing.properties
android/*.jks
android/app/build/
android/.idea/

# Kali terminal PRoot reproducible-build intermediates and downloaded inputs
proot/.kali-terminal-stage/
proot/kali-sources/
proot/tools/get-pip.py
proot/kali-terminal-rootfs-build.log

# Local Android native build cache and validation logs
android/app/.cxx/
android/*.log
test-output*.log
proot/kali-terminal-rootfs-build-*.log
release-assets/
staged-diff-check.log
