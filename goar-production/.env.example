# Provider selection
FREEAI_API_KEY=
FREEAI_API_BASE=https://api.free.ai/v1
FREEAI_MODEL=qwen7b

# Generic OpenAI-compatible provider override
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=
GOAR_API_KEY=
GOAR_API_BASE=
GOAR_MODEL=

# Local service configuration
GOAR_HOST=127.0.0.1
GOAR_PORT=8080
GOAR_HOME=/var/lib/goar
GOAR_WORKSPACE=/var/lib/goar/workspace
GOAR_REQUIRE_KEY=
GOAR_AUTO_INSTALL_DESKTOP=0

# Optional outbound web-tool proxy configuration
PROXY_USER=
PROXY_PASS=
PROXY_LIST=
GOAR_DISABLE_PROXIES=0
