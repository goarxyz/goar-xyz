# GOAR OS Alpine PRoot local service configuration
# The launcher binds the service to localhost by default and retains all state
# in proot/state/ and operator-created files in proot/workspace/.
GOAR_HOST=127.0.0.1
GOAR_PORT=8080
GOAR_REQUIRE_KEY=

# Configure one OpenAI-compatible provider for live agent execution.
GOAR_API_KEY=
GOAR_API_BASE=
GOAR_MODEL=

# Legacy Free.ai-compatible configuration remains supported.
FREEAI_API_KEY=
FREEAI_API_BASE=https://api.free.ai/v1
FREEAI_MODEL=qwen7b
