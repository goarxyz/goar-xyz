# GOAR OS network boundary. Keep 127.0.0.1 unless a trusted reverse proxy is in front.
GOAR_BIND_ADDRESS=127.0.0.1
GOAR_PORT=8080

# Set these to `id -u` and `id -g` on Linux so files created in ./workspace
# remain owned by your local account. The defaults match the common first user.
GOAR_UID=1000
GOAR_GID=1000

# Required whenever the service is reachable by another device or network.
# Generate with: openssl rand -hex 32
GOAR_REQUIRE_KEY=

# Choose one OpenAI-compatible model provider. Leave blank to start the local UI
# before configuring a provider in the setup screen.
GOAR_API_KEY=
GOAR_API_BASE=
GOAR_MODEL=

# Optional Free.ai-compatible provider aliases.
FREEAI_API_KEY=
FREEAI_API_BASE=https://api.free.ai/v1
FREEAI_MODEL=qwen7b
